@model List<DewanSoftTask.Models.Item>

@{
    ViewData["Title"] = "Create Receipt";
}

<h2>Create Receipt</h2>

<form method="post">
    <div>
        <label for="itemIds">Items:</label>
        <select name="itemIds" id="itemIds" multiple>
            @foreach (var item in Model)
            {
                <option value="@item.Id">@item.Name - @item.Price.ToString("0")</option>
            }
        </select>
    </div>

    <div>
        <label for="quantities">Quantities:</label>
        <input type="text" name="quantities" id="quantities" placeholder="Enter quantities" />
    </div>

    <div>
        <label for="paidAmount">Paid Amount:</label>
        <input type="number" name="paidAmount" id="paidAmount" placeholder="Enter amount paid" />
    </div>

    <button type="submit">Create Receipt</button>
</form>

@if (TempData["Error"] != null)
{
    <div style="color: red;">
        <p>@TempData["Error"]</p>
    </div>
}

@if (ViewData["UpdatedItems"] != null)
{
    <div>
        <h3>Updated Item Stock:</h3>
        <ul>
            @foreach (var item in ViewData["UpdatedItems"] as List<DewanSoftTask.Models.Item>)
            {
                <li>@item.Name - Available Stock: @item.Balance</li>
            }
        </ul>
    </div>
}

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
    }

    .form-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh; /* Full viewport height */
    }

    .container {
        background-color: #fff;
        padding: 30px;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        width: 100%;
        max-width: 600px; /* Limit form width */
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
        color: #333;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    label {
        font-size: 14px;
        font-weight: bold;
        color: #333;
    }

    select,
    input[type="text"],
    input[type="number"] {
        padding: 10px;
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 5px;
        width: 100%;
        margin-top: 5px;
    }

    button {
        padding: 10px 15px;
        background-color: #007bff;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
    }

        button:hover {
            background-color: #0056b3;
        }

    .error-message {
        color: red;
        text-align: center;
        font-size: 16px;
        margin-bottom: 20px;
    }

    .result {
        margin-top: 20px;
        font-size: 16px;
        color: #333;
    }

        .result p {
            margin: 5px 0;
        }
</style>
